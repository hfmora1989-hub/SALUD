{
  "projects": {
    "default": "health-analytics-staging",
    "staging": "health-analytics-staging",
    "production": "health-analytics-prod"
  },
  "targets": {
    "health-analytics-staging": {
      "hosting": {
        "staging": [
          "health-analytics-staging"
        ],
        "production": [
          "health-analytics-staging"
        ]
      }
    },
    "health-analytics-prod": {
      "hosting": {
        "staging": [
          "health-analytics-prod"
        ],
        "production": [
          "health-analytics-prod"
        ]
      }
    }
  }
}
